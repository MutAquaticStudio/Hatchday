{
  "name": "hatchday",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Game nuôi thú ảo 3D phong cách anime trên web",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p admin --noEmit && vite build && vite build -c vite.admin.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run supabase/tests",
    "dev:admin": "vite -c vite.admin.config.ts",
    "build:admin": "tsc -p admin --noEmit && vite build -c vite.admin.config.ts",
    "build:steam": "VITE_PLATFORM=steam vite build --outDir desktop/dist --emptyOutDir",
    "desktop": "npm run build:steam && cd desktop && npm start"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
